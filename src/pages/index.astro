---
// Importing TailWind
import '../styles/global.css'
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const recent = (await getCollection('articles'))
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0,3);
---

<Layout title="Benedikt Janda - Physics">
	
	<section class="mb-8">
		<h1>Benedikt Janda</h1>
		<p>
			Master's student of Theoretical Physics (ITP) and Particle and Nuclear Physics (IPNP)
			at the Faculty of Mathematics and Physics, Charles University.
		</p>
	</section>

	<section class="mb-8">
		<h2 class="mb-2 text-xl font-bold">About my research</h2>
		<p>
			I am currently writing two master's theses: one in particle physics on scattering amplitudes in the extended nonlinear sigma model (NLSM), and one in theoretical physics on the relativistic orbital dynamics of plasma in tidal disruption events. 
			I also continue to collaborate on research in numerical stochastic thermodynamics, building upon my recent student faculty grant project.
			My primary interests lie in theoretical particle physics, effective field theories, quantum gravity, holography and black hole thermodynamics.
		</p>
	</section>

	<section class="mb-8">
		<h2 class="mb-2 text-xl font-bold">Featured projects</h2>
		<p class="mt-2">
			<code>LSolver</code>: a Python package for numerical solution of overdamped and underdamped Langevin equations with arbitrary force fields. Uses Euler-Maruyama and a second-order Verlet-type scheme, with reproducible random seeds, documentation and automated tests. <a href="https://github.com/Ben-Janda/LSolver">[GitHub→]</a>
		</p>
		
		<p class="mt-2">
			Published paper about magnetopause. <a href="https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2024JA033181">Dawn-Dusk Asymmetry of the Magnetopause Distance Under the Parker Spiral Configuration of the IMF</a>
		</p>
	</section>

	<section class="mb-8">
		<h2 class="mb-2 text-xl font-bold">Recent articles</h2>
		<ul>
			{recent.map((a) => (
				<li>
					<a href={`${base}/articles/${a.id}/`}>{a.data.title}</a>
					- {a.data.date.toISOString().slice(0, 10)}
				</li>
			))}
		</ul>
		<p class="mt-2"><a href={`${base}/articles/`}>All articles</a></p>
	</section>

	<section class="mb-8">
		<h2 class="mb-2 text-xl font-bold">Contact</h2>
		<ul>
			<li>Email: benedikt.janda951 (at) student.cuni.cz</li>
			<li>GitHub: <a href="https://github.com/Ben-Janda">github.com/Ben-Janda</a></li>
			<li>ORCID: <a href="https://orcid.org/">0009-0009-2584-0325</a></li>
		</ul>
	</section>
</Layout>